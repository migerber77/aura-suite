# Kopiere diese Datei zu ".env" und trage deine echten Werte ein.

# Geheimer Schlüssel fürs Lizenzsystem. MUSS EXAKT derselbe Wert sein wie
# LICENSE_SECRET in der .env jeder AuraChat-Instanz, die hier erzeugte
# Lizenzen akzeptieren soll. Erzeugen z.B. mit: openssl rand -hex 32
# NIEMALS weitergeben, committen oder öffentlich teilen!
LICENSE_SECRET=hier-den-gleichen-wert-wie-bei-aurachat-einsetzen

# Passwort für den Superadmin-Zugang zum Lizenz-Server (Benutzername immer "admin",
# sieht/verwaltet ALLES inkl. Reseller-Konten). Da dieser Server öffentlich erreichbar
# ist: ein wirklich starkes, einzigartiges Passwort verwenden!
LICENSE_SERVER_PASSWORD=hier-ein-starkes-eigenes-passwort-einsetzen

# Zufallswert für die Anmelde-Sitzungen (Admin & Reseller). Ohne diesen Wert bleibt
# niemand nach einem Neustart angemeldet. Erzeugen z.B. mit: openssl rand -hex 32
SESSION_SECRET=hier-einen-langen-zufaelligen-wert-einsetzen
