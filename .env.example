# Aura-Suite: Einstellungen. Kopieren nach ".env" und die Werte eintragen.
# Zufallswerte erzeugen:  openssl rand -hex 32   (für AMI_SECRET reicht: openssl rand -hex 24)
# Diese Datei kommt NIE ins Repository (.env steht in der .gitignore).

TZ=Europe/Zurich

# Optional: Version der Aura-Suite (z. B. 2.1.0). Erscheint in allen Anwendungen unter "Über Aura-Suite".
# Bei einem Update der Suite hier die neue Nummer eintragen.
# AURA_SUITE_VERSION=

# ---- Gemeinsam: Lizenz-Geheimnis. EIN Wert für ALLE Produkte, auch für den Lizenzserver (lic).
LICENSE_SECRET=

# ---- AuraChat
CHAT_PORT=8091
CHAT_SESSION_SECRET=
CHAT_DISPOSITION_KEY=
# OLLAMA_TIMEOUT_MINUTES=20
# OLLAMA_MAX_TOKENS=2048
# Sprache (nur mit:  docker compose --profile voice up -d)
# TTS_PORT=8096
# PIPER_ARGS=--voice de_DE-kerstin-low

# ---- AuraPlan / AuraTicket / AuraMail
PLAN_PORT=8080
PLAN_SESSION_SECRET=
TICKET_PORT=3400
TICKET_SESSION_SECRET=
MAIL_PORT=3300
MAIL_SMTP_PORT=2525
MAIL_SESSION_SECRET=
MAIL_ENCRYPTION_KEY=

# ---- AuraDirect
DIRECT_PORT=4000
DIRECT_LDAP_PORT=389
DIRECT_SESSION_SECRET=
DIRECT_ADMIN_PASSWORD=
DIRECT_SERVICE_KEY=

# ---- AuraProxy (80/443 gehören dem Caddy von AuraProxy)
HTTP_PORT=80
HTTPS_PORT=443
PROXY_SESSION_SECRET=
# Web-Oberfläche von AuraProxy: Standard nur auf diesem Rechner erreichbar. Im Heimnetz z. B. PROXY_UI_BIND=10.0.55.160
PROXY_UI_BIND=127.0.0.1
PROXY_UI_PORT=3500

# ---- AuraCall (Telefon; läuft im Host-Netzwerk, Verwaltung auf Port 8110)
CALL_AMI_SECRET=
CALL_PORT=8110
CALL_BIND=0.0.0.0
CALL_TRUST_PROXY=false
CALL_ADMIN_PASSWORD=
# Falls AuraCall bei der Ersteinrichtung den Zwei-Faktor-Zugang zurücksetzen soll (danach wieder leeren):
# CALL_RESET_2FA=admin
# Rückmeldung von AuraCall beim Lizenzserver. Standard: der Server des Herstellers. Leer eintragen (LICENSE_CHECKIN_HOST=) schaltet sie ab.
# LICENSE_CHECKIN_HOST=auralic.gerber-backoffice-solutions.com

# ---- AuraLic (Lizenzserver)
LIC_PORT=8451
LIC_ADMIN_PASSWORD=
LIC_SESSION_SECRET=
# Der Lizenzserver blockiert ALLE Anmeldungen, solange LIC_ADMIN_PASSWORD leer ist (Meldung: "LICENSE_SERVER_PASSWORD fehlt").
# Aus einer bisherigen eigenständigen AuraLic-.env werden diese Namen ersatzweise erkannt (nur wenn die obigen leer sind):
# LICENSE_SERVER_PASSWORD=
# SESSION_SECRET=

# ---- Apaleo (Hotel-PMS): Verbinden per Knopf in AuraChat (OAuth 2.0)
# Beim Kunden: leer lassen (Standard: Vermittler des Herstellers). Nur wenn AuraChat hinter einem Proxy die eigene Adresse nicht erkennt:
# APALEO_CONNECT_URL=
# APALEO_RETURN_BASE=https://chat.meinhotel.ch
# Nur beim Hersteller (Dienst "lic"): Werte der Apaleo Store-App. Die Redirect URI muss in Apaleo genau so eingetragen sein (https).
# APALEO_CLIENT_ID=
# APALEO_CLIENT_SECRET=
# APALEO_REDIRECT_URI=https://auralic.gerber-backoffice-solutions.com/apaleo/callback

# ---- Optional: andere Image-Namen (nur nötig, wenn sie nicht unter diesen Namen veröffentlicht sind)
# CHAT_BACKEND_IMAGE=migerber77/aurachat:backend
# CALL_ASTERISK_IMAGE=migerber77/aura-suite:call-asterisk
# LIC_IMAGE=migerber77/aura-suite:lic

# ---- AuraControl (Server-Übersicht)
# Optional: Anfangspasswort des Administrators (mindestens 10 Zeichen). Leer = zufälliges Passwort, das EINMAL im Protokoll steht (docker compose logs auracontrol).
# CONTROL_ADMIN_PASSWORD=
