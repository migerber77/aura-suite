# Eigene Zufallswerte eintragen, z.B. erzeugt mit: openssl rand -hex 32
SESSION_SECRET=
AURADIRECT_ADMIN_PASSWORD=

# Optional - wird beim allerersten Start automatisch erzeugt und im Admin Panel
# unter "Benutzer" angezeigt, falls hier leer gelassen. Nur ausfüllen, wenn ihr
# selbst einen bestimmten Wert vorgeben wollt.
AURADIRECT_SERVICE_KEY=

# Muss GENAU dem LICENSE_SECRET auf eurem Lizenz-Server entsprechen (gleiche Datei/Wert
# wie bei AuraChat/AuraPlan) - sonst kann keine Lizenz geprüft werden.
LICENSE_SECRET=
