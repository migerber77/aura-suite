# Pflicht: derselbe Wert wie LICENSE_SECRET beim Lizenzserver (prüft die Lizenzschlüssel)
LICENSE_SECRET=
# Optional: Anfangspasswort (mindestens 10 Zeichen). Leer = zufälliges Passwort, einmal im Protokoll: docker compose logs auracontrol
CONTROL_ADMIN_PASSWORD=
# Optional: Version der Aura-Suite, die unter "Über Aura-Suite" als installiert erscheint
# AURA_SUITE_VERSION=
# Anonyme Rückmeldung an den Lizenzserver (nicht abschaltbar; leer = Lizenzserver des Herstellers). Nur für einen EIGENEN Lizenzserver ändern.
# LICENSE_CHECKIN_HOST=
