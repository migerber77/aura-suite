# AuraCall - Einstellungen. Am einfachsten: ./setup.sh ausführen, das erzeugt die Datei ".env" mit einem zufälligen AMI_SECRET.

# Passwort, mit dem AuraCall Asterisk steuert (nur lokal). Wird von setup.sh erzeugt. Nur Buchstaben, Ziffern, _ und -, 16 bis 128 Zeichen.
AMI_SECRET=

# Port der Verwaltung im Browser (http://SERVER:8110)
AURACALL_PORT=8110
# Auf welcher Adresse die Verwaltung hört. 127.0.0.1 = nur auf dem Server selbst (z.B. wenn ein Proxy davorsteht)
AURACALL_BIND=0.0.0.0
# "true" nur hinter einem vertrauenswürdigen Proxy (Caddy/nginx), der X-Forwarded-For und X-Forwarded-Proto setzt
TRUST_PROXY=false

# Optional: Anfangspasswort für das Konto "admin" (muss beim ersten Anmelden geändert werden). Leer = zufälliges Passwort im Protokoll.
# Lizenz: DERSELBE Wert wie LICENSE_SECRET auf dem Lizenzserver (und bei AuraChat). Ohne ihn lässt sich kein Lizenzschlüssel prüfen;
# dann läuft AuraCall nur die 14 Tage Probezeit.
LICENSE_SECRET=

# Rückmeldung beim Lizenzserver (alle 12 Stunden: Lizenzschlüssel, zufällige Installationskennung, Version, Zahl der Konten; nie Anrufdaten).
# Standard: der Lizenzserver des Herstellers. Leer lassen (LICENSE_CHECKIN_HOST=) schaltet die Rückmeldung aus.
# LICENSE_CHECKIN_HOST=auralic.gerber-backoffice-solutions.com

# Notfall: Handy verloren und keine Notfall-Codes mehr? Hier den Benutzernamen eintragen (z.B. admin), 'docker compose up -d' ausführen,
# dann ist die Zwei-Faktor-Anmeldung dieses Kontos aus. Danach die Zeile WIEDER LEER lassen.
AURACALL_RESET_2FA=

ADMIN_PASSWORD=
