# Kopiere diese Datei zu ".env" und trage deine echten Werte ein.

# Zufälliger, geheimer Wert. Erzeugen z.B. mit: openssl rand -hex 32
SESSION_SECRET=hier-einen-langen-zufaelligen-wert-einsetzen

# Muss GENAU derselbe Wert wie euer LICENSE_SECRET auf dem Lizenz-Server sein.
LICENSE_SECRET=hier-denselben-wert-wie-beim-lizenz-server-einsetzen
