# Kopiere diese Datei zu ".env" und trage deinen echten Wert ein.
# docker-compose liest .env automatisch ein.

# Zufälliger, geheimer Wert zum Signieren der Session-Cookies.
# Erzeugen z.B. mit: openssl rand -hex 32
SESSION_SECRET=hier-einen-langen-zufaelligen-wert-einsetzen

# Geheimer Schlüssel fürs Lizenzsystem (Premium-Features wie SSL-Verwaltung,
# Chat-Hintergrundbild). Erzeugen z.B. mit: openssl rand -hex 32
# WICHTIG: Diesen Wert NIE weitergeben oder committen - wer ihn kennt, kann
# beliebige gültige Lizenzen erzeugen! Denselben Wert auch im separaten
# Lizenz-Server-Projekt verwenden, um Lizenzen zu generieren.
LICENSE_SECRET=hier-einen-anderen-langen-zufaelligen-wert-einsetzen

# Die Domain wird NICHT mehr hier eingetragen - das passiert jetzt im
# Admin Panel von AuraChat selbst (Menü -> Admin Panel -> SSL-Zertifikate).

# SMTP-Zugangsdaten für E-Mail-Benachrichtigungen werden ebenfalls NICHT mehr
# hier eingetragen, sondern im Admin Panel von AuraChat (Menü -> Admin Panel ->
# Mailserver) - landen sicher in der Datenbank statt im Klartext in dieser Datei.

# Stimme für die Sprachausgabe (Piper, mitgelieferter Container). Ohne diese Zeile gilt die deutsche Stimme
# "de_DE-kerstin-low" (weiblich). Andere Stimme oder bei Mehrsprecher-Stimmen ein Sprecher, z.B.:
#   PIPER_ARGS=--voice de_DE-mls-medium --speaker 198
# Stimmen zum Anhören: rhasspy.github.io/piper-samples   (nach einer Änderung: docker compose up -d piper)
# PIPER_ARGS=--voice de_DE-kerstin-low

# Grenzen für Antworten der KI (Ollama) - nur bei Bedarf ändern (Standard in Klammern):
#   OLLAMA_TIMEOUT_MINUTES=20   maximale Wartezeit auf eine Antwort
#   OLLAMA_MAX_TOKENS=2048      maximale Länge einer Antwort (längere werden gekürzt und mit Hinweis versehen)
