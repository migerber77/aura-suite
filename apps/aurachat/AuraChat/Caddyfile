{
    admin 0.0.0.0:2019 {
        origins http://caddy:2019
        enforce_origin
    }
}

# Fallback, solange im Admin Panel noch keine Domain gesetzt wurde:
# einfacher HTTP-Proxy ohne TLS. Sobald ein Admin im Admin Panel eine Domain
# einträgt, ersetzt das Backend diese Konfiguration live über die Caddy Admin-API
# durch einen Domain-Block mit automatischem HTTPS.
:80 {
    reverse_proxy aurachat:80
}
