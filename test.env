# Aura-Suite: Einstellungen. Kopieren nach ".env" und die Werte eintragen.
# Zufallswerte erzeugen:  openssl rand -hex 32   (für AMI_SECRET reicht: openssl rand -hex 24)
# Diese Datei kommt NIE ins Repository (.env steht in der .gitignore).

TZ=Europe/Zurich

# ---- Gemeinsam: Lizenz-Geheimnis. EIN Wert für ALLE Produkte, auch für den Lizenzserver (lic).
LICENSE_SECRET=

# ---- AuraChat
CHAT_PORT=8091
CHAT_SESSION_SECRET=
CHAT_DISPOSITION_KEY=
# OLLAMA_TIMEOUT_MINUTES=20
# OLLAMA_MAX_TOKENS=2048
# Sprache (nur mit:  docker compose --profile voice up -d)
# TTS_PORT=8096
# PIPER_ARGS=--voice de_DE-kerstin-low

# ---- AuraPlan / AuraTicket / AuraMail
PLAN_PORT=8080
PLAN_SESSION_SECRET=
TICKET_PORT=3400
TICKET_SESSION_SECRET=
MAIL_PORT=3300
MAIL_SMTP_PORT=2525
MAIL_SESSION_SECRET=
MAIL_ENCRYPTION_KEY=

# ---- AuraDirect
DIRECT_PORT=4000
DIRECT_LDAP_PORT=389
DIRECT_SESSION_SECRET=
DIRECT_ADMIN_PASSWORD=
DIRECT_SERVICE_KEY=

# ---- AuraProxy (80/443 gehören dem Caddy von AuraProxy)
HTTP_PORT=80
HTTPS_PORT=443
PROXY_SESSION_SECRET=
# Web-Oberfläche von AuraProxy: Standard nur auf diesem Rechner erreichbar. Im Heimnetz z. B. PROXY_UI_BIND=10.0.55.160
PROXY_UI_BIND=127.0.0.1
PROXY_UI_PORT=3500

# ---- AuraCall (Telefon; läuft im Host-Netzwerk, Verwaltung auf Port 8110)
CALL_AMI_SECRET=
CALL_PORT=8110
CALL_BIND=0.0.0.0
CALL_TRUST_PROXY=false
CALL_ADMIN_PASSWORD=
# Falls AuraCall bei der Ersteinrichtung den Zwei-Faktor-Zugang zurücksetzen soll (danach wieder leeren):
# CALL_RESET_2FA=admin
# Rückmeldung von AuraCall beim Lizenzserver. Standard: der Server des Herstellers. Leer eintragen (LICENSE_CHECKIN_HOST=) schaltet sie ab.
# LICENSE_CHECKIN_HOST=auralic.gerber-backoffice-solutions.com

# ---- AuraLic (Lizenzserver)
LIC_PORT=8451
LIC_ADMIN_PASSWORD=
LIC_SESSION_SECRET=
